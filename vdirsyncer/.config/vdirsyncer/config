[general]
status_path = "~/.local/share/vdirsyncer/status/"

[pair contacts]
a = "contacts_local"
b = "contacts_remote"
collections = ["from b"]
metadata = ["displayname"]

[storage contacts_local]
type = "filesystem"
path = "~/.local/share/vdirsyncer/contacts/"
fileext = ".vcf"

[storage contacts_remote]
type = "carddav"
url = "https://ew1.mooo.com:9443/remote.php/dav/"
username = "cdriller"
password.fetch = ["command", "pass", "show", "vdirsyncer"]

[pair calendars]
a = "calendars_local"
b = "calendars_remote"
collections = ["from b"]

[storage calendars_local]
type = "filesystem"
path = "~/.local/share/vdirsyncer/calendars/"
fileext = ".ics"

[storage calendars_remote]
type = "caldav"
url = "https://ew1.mooo.com:9443/remote.php/dav/"
username = "cdriller"
password.fetch = ["command", "pass", "show", "vdirsyncer"]
